# Copy this file to .env and adjust if your MySQL/XAMPP setup differs.
# Default matches a fresh XAMPP install: MySQL on localhost:3306, user "root", no password.
DATABASE_URL="mysql://root:@localhost:3306/ohmygas"

# Any long random string works. scripts/setup-db.js will generate one for you
# automatically the first time it creates .env, so you don't need to fill this in by hand.
JWT_SECRET="replace-with-a-long-random-string"
